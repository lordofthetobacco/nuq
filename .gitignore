# Ignore everything by default. Allow the files used to build and test nuq.
*
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/CMakePresets.json

!/cmake/
!/cmake/*.cmake
!/src/
!/src/*.c
!/src/*.h
!/src/*.manifest
!/src/pi_extension.ts

!/skills/
!/skills/nuq/
!/skills/nuq/SKILL.md
!/third_party/
!/third_party/cjson/
!/third_party/cjson/cJSON.c
!/third_party/cjson/cJSON.h
!/third_party/cjson/LICENSE

!/tests/
!/tests/CMakeLists.txt
!/tests/*.c
!/tests/*.h
!/tests/*.sh
!/tests/pi_host.mjs
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/.github/workflows/release.yml
